<?xml version="1.0" encoding="utf-8"?>
<!--
    ───── A.2: CONTAINERUL PRINCIPAL ─────
    - LinearLayout vertical: copiii lui se așază unul sub altul
    - id-ul "main" TREBUIE păstrat: activitatea generată de template
      îl caută cu findViewById(R.id.main) pentru marginile de sistem (edge-to-edge)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".PracticalTest01MainActivity">

    <!--
        ───── C.2: butonul care deschide activitatea secundară ─────
        - primul în layout, ca să apară SUS, ca în imaginea din enunț
        - layout_gravity="end": aliniat la dreapta
    -->
    <Button
        android:id="@+id/navigate_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="32dp"
        android:text="NAVIGATE TO SECONDARY ACTIVITY" />

    <!--
        ───── A.2: RÂNDUL CU CELE DOUĂ JUMĂTĂȚI ─────
        - orizontal: cele două coloane stau una lângă cealaltă („dispuse pe o linie”)
        - weightSum="2": spațiul se împarte în 2 părți egale
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <!--
            ───── A.2: COLOANA STÂNGĂ (câmp text + buton dedesubt) ─────
            - layout_width="0dp" + layout_weight="1" → ocupă exact 1/2 din lățime
              (0dp = „nu calcula lățimea după conținut, ia-o doar din weight”)
            - vertical: butonul ajunge DEDESUBTUL câmpului text
            - marginEnd: puțin spațiu între cele două jumătăți
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <!--
                A.2: CÂMPUL TEXT STÂNG
                - match_parent: umple toată lățimea coloanei (adică jumătate de ecran)
                - text="0": valoarea inițială cerută
                - gravity="center": cifra apare centrată în câmp
                - enabled="false": câmpul e NEEDITABIL (doar codul îl modifică, B.1)
                B.2 a:
                - saveEnabled="false": fără salvare automată a textului
            -->
            <EditText
                android:id="@+id/left_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="center"
                android:enabled="false"
                android:saveEnabled="false" />

            <!--
                A.2: BUTONUL STÂNG (click-ul e tratat în B.1)
                - wrap_content: atât de lat cât îi trebuie textului
                - layout_gravity="center_horizontal": butonul e CENTRAT
                  față de coloană, deci față de câmpul text de deasupra
            -->
            <Button
                android:id="@+id/left_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="PRESS ME!" />
        </LinearLayout>

        <!-- ───── A.2: COLOANA DREAPTĂ: identică, cu marginStart în loc de marginEnd ───── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <!-- A.2: CÂMPUL TEXT DREPT: aceleași proprietăți ca cel stâng (inclusiv B.2 a) -->
            <EditText
                android:id="@+id/right_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="center"
                android:enabled="false"
                android:saveEnabled="false" />

            <!-- A.2: BUTONUL DREPT: centrat sub câmpul text drept (click-ul în B.1) -->
            <Button
                android:id="@+id/right_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="PRESS ME, TOO!" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>